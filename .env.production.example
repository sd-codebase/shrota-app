# Database
DB_USER=shrota
DB_PASSWORD=your_strong_password_here
DB_NAME=shrota

# Backend
CORS_ORIGINS=https://admin.shrota.in,http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=your_production_jwt_secret_here

# Frontend (admin dashboard)
VITE_API_URL=https://api.shrota.in
VITE_CDN_URL=https://audiolibrary.shrota.in

# Website
NEXT_PUBLIC_API_URL=https://api.shrota.in

# Google Play Billing (in-app purchases). The service-account JSON is never
# committed (gitignored). See CLAUDE.md → Payments for Play Console setup.
GOOGLE_PLAY_PACKAGE_NAME=com.shrota.app
# Audience set on the Pub/Sub push subscription, and the service account it signs as
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
# Regions products/plans are priced in (comma-separated ISO codes)
GOOGLE_PLAY_PRICE_REGIONS=IN
GOOGLE_PLAY_SYNC_ENABLED=true
