DATABASE_URL=postgresql+asyncpg://shrota:shrota123@localhost:5432/shrota
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
AUDIO_LIBRARY_DIR=../audio-library/shrota-audio-library
JWT_SECRET_KEY=change-in-production

# Notification settings (development = console only, production = send emails)
NOTIFICATION_MODE=development

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@shrota.in
SMTP_FROM_NAME=Shrota Audiobooks
SMTP_USE_TLS=true

# Google Play Billing (in-app purchases). The service-account JSON is never
# committed (gitignored). See CLAUDE.md → Payments for Play Console setup.
GOOGLE_PLAY_PACKAGE_NAME=com.shrota.app
# Audience set on the Pub/Sub push subscription, and the service account it signs as
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
# Regions products/plans are priced in (comma-separated ISO codes)
GOOGLE_PLAY_PRICE_REGIONS=IN
GOOGLE_PLAY_SYNC_ENABLED=false
