FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Don't copy source - it will be mounted as volume
# COPY . .

EXPOSE 5173

# Run Vite dev server with hot-reload
# --host allows connections from outside container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
